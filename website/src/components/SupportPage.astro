---
import Shell from '../layouts/Shell.astro';
import { siteConfig } from '../../site.config.mjs';

import { tr, localizedUrl } from '../i18n';
const { locale = 'fr' } = Astro.props;
---
<Shell locale={locale} title={tr(locale, "Assistance et contact")} page="support" description={tr(locale, "Créer ou rejoindre une partie INVASION, résoudre les problèmes de réseau local et retrouver sa licence d’hébergement.")}>
  <div class="wrap document-header"><p class="eyebrow">{tr(locale, "Assistance")}</p><h1>{tr(locale, "Retrouvez")}<br /><em>{tr(locale, "votre équipage.")}</em></h1><p>{tr(locale, "Les premiers pas, les vérifications réseau et les réponses aux questions sur la licence.")}</p></div>
  <div class="wrap document-grid">
    <aside class="document-toc" aria-label={tr(locale, "Sommaire")}><p class="eyebrow">{tr(locale, "Un coup de main")}</p><a href="#creer">{tr(locale, "Créer une partie")}</a><a href="#rejoindre">{tr(locale, "Rejoindre une partie")}</a><a href="#connexion">{tr(locale, "Connexion locale")}</a><a href="#achats">{tr(locale, "Achats intégrés")}</a><a href="#sauvegardes">{tr(locale, "Sauvegardes")}</a><a href="#contact">{tr(locale, "Nous contacter")}</a></aside>
    <article class="prose">
      <section id="creer"><h2>{tr(locale, "Créer une partie")}</h2><ol><li>{tr(locale, "Réunissez 5 à 25 joueurs et un maître du jeu supplémentaire, qui ne joue pas.")}</li><li>{tr(locale, "Installez une version compatible d’INVASION sur les appareils et connectez-les au même réseau local.")}</li><li>{tr(locale, "Sur l’appareil du MJ, choisissez ")}<strong>{tr(locale, "Créer une partie")}</strong>{tr(locale, ". Activez ou restaurez la licence d’hébergement si nécessaire.")}</li><li>{tr(locale, "Partagez l’invitation affichée dans le salon. Les joueurs peuvent scanner le QR code ou utiliser le code d’invitation.")}</li><li>{tr(locale, "Lorsque le groupe est prêt, suivez les étapes de préparation et les indications du MJ dans l’application.")}</li></ol><p>{tr(locale, "Gardez l’appareil du MJ allumé, chargé et l’application au premier plan pendant la partie.")}</p></section>
      <section id="rejoindre"><h2>{tr(locale, "Rejoindre une partie")}</h2><ol><li>{tr(locale, "Ouvrez ")}<strong>{tr(locale, "Rejoindre une partie")}</strong>{tr(locale, " et utilisez l’invitation du salon actuel.")}</li><li>{tr(locale, "Autorisez l’accès au réseau local sur iPhone ou iPad. Pour scanner le QR code, autorisez aussi la caméra.")}</li><li>{tr(locale, "Choisissez votre pseudonyme et votre apparence, puis rejoignez le salon.")}</li></ol><p>{tr(locale, "Aucune licence n’est nécessaire pour les joueurs invités. Ne publiez pas l’invitation d’une partie réelle : elle permet d’accéder au salon sur le réseau concerné.")}</p></section>
      <section id="connexion"><h2>{tr(locale, "Un problème de connexion ?")}</h2>
        <details open><summary>{tr(locale, "Les appareils sont sur le Wi-Fi, mais la connexion échoue")}</summary><div><p>{tr(locale, "Vérifiez qu’ils utilisent bien le même réseau. Un Wi-Fi « invités », un réseau d’entreprise ou l’isolation des clients du routeur peut empêcher les appareils de communiquer, même si Internet fonctionne.")}</p><p>{tr(locale, "Essayez un réseau privé autorisant les communications locales. Un partage de connexion peut convenir selon les appareils et leur configuration ; sa compatibilité n’est pas garantie dans tous les cas.")}</p></div></details>
        <details><summary>{tr(locale, "iPhone ou iPad : vérifier l’autorisation réseau local")}</summary><div><p>{tr(locale, "Dans les réglages iOS, recherchez INVASION et vérifiez l’accès au réseau local. Il peut aussi se trouver sous Confidentialité et sécurité → Réseau local. Le chemin dépend de la version d’iOS.")}</p><p>{tr(locale, "Si vous avez refusé la caméra, vous pouvez toujours utiliser le code d’invitation manuellement.")}</p></div></details>
        <details><summary>{tr(locale, "Le code est correct, mais le salon reste introuvable")}</summary><div><p>{tr(locale, "Demandez au MJ de repartager l’invitation depuis le salon ouvert. Une ancienne invitation peut désigner une autre session, une autre adresse ou un ancien port.")}</p><p>{tr(locale, "Vérifiez aussi que l’application est ouverte chez le MJ et que son appareil n’a pas changé de réseau. Pour un essai, désactivez temporairement le VPN s’il bloque les communications locales.")}</p></div></details>
        <details><summary>{tr(locale, "La connexion se coupe pendant la partie")}</summary><div><p>{tr(locale, "Revenez au premier plan, gardez le même réseau et essayez la reconnexion proposée par l’application. Évitez de supprimer vos sauvegardes ou de réinitialiser les clés protégées pour résoudre un problème réseau.")}</p><p>{tr(locale, "Si le problème persiste, notez le message exact et les versions des appareils avant de contacter l’assistance.")}</p></div></details>
        <details><summary>{tr(locale, "Faut-il une connexion Internet pour jouer ?")}</summary><div><p>{tr(locale, "La partie utilise le réseau local. Après activation de la licence, Internet n’est pas nécessaire au déroulement de la partie. Les achats, la restauration et la synchronisation avec Apple ou Google nécessitent une connexion aux services du store.")}</p></div></details>
      </section>
      <section id="achats"><h2>{tr(locale, "La licence et les achats intégrés")}</h2>
        <details><summary>{tr(locale, "Qui doit acheter une licence ?")}</summary><div><p>{tr(locale, "Le maître du jeu a besoin d’une licence d’hébergement. Cet achat unique non consommable couvre jusqu’à 25 joueurs, sans compter le MJ. Les participants invités jouent gratuitement.")}</p><p>{tr(locale, "Le prix est affiché dans l’application par le store. Aucun prix ni achat ne sont proposés sur ce site.")}</p></div></details>
        <details><summary>{tr(locale, "Le bouton Acheter est grisé ou aucun prix ne s’affiche")}</summary><div><p>{tr(locale, "Vérifiez votre connexion Internet, votre connexion au store et l’installation depuis le canal officiel Apple ou Google. Fermez puis rouvrez l’écran de licence.")}</p><p>{tr(locale, "Si le produit reste indisponible, contactez l’assistance en indiquant la version de l’app et le message de diagnostic. N’achetez pas une seconde fois pour tenter de résoudre ce problème.")}</p></div></details>
        <details><summary>{tr(locale, "Restaurer un achat ou changer d’appareil")}</summary><div><p>{tr(locale, "Utilisez ")}<strong>{tr(locale, "Restaurer mes achats")}</strong>{tr(locale, " avec le même compte de store que lors de l’achat et une connexion Internet. Les achats Apple et Google appartiennent à deux systèmes distincts : un achat sur l’un ne se restaure pas automatiquement sur l’autre.")}</p><p>{tr(locale, "Un achat en attente ne débloque pas l’hébergement tant qu’il n’est pas confirmé. Les demandes de remboursement se font auprès du store concerné.")}</p></div></details>
        <details><summary>{tr(locale, "Comment fonctionnent les achats en bêta ?")}</summary><div><p>{tr(locale, "Suivez les consignes du groupe de test. Les achats fictifs nécessitent une configuration officielle : compte de test de licence Google Play ou environnement de test Apple/TestFlight. Le simple fait d’être invité à un test Google Play ne garantit pas la gratuité de l’achat.")}</p><p>{tr(locale, "Ne confirmez aucun paiement réel pour tester : vérifiez que le store affiche bien le contexte de test attendu.")}</p></div></details>
      </section>
      <section id="sauvegardes"><h2>{tr(locale, "Une sauvegarde illisible ?")}</h2><p>{tr(locale, "Conservez vos données et contactez l’assistance avec le texte de l’erreur. Ne réinitialisez pas les clés protégées : elles peuvent être nécessaires pour ouvrir les sauvegardes.")}</p><p>{tr(locale, "Si vous souhaitez supprimer une sauvegarde, quittez la partie puis ouvrez ")}<strong>{tr(locale, "Paramètres → Sauvegardes locales")}</strong>{tr(locale, ". Cette suppression est définitive sur cet appareil. Les licences et clés protégées restent conservées.")}</p></section>
      <section id="contact" class="contact-panel"><p class="eyebrow">{tr(locale, "Contact")}</p><h2>{tr(locale, "Besoin d’aide ?")}</h2><p>{tr(locale, "Précisez la version d’INVASION, le modèle d’appareil, la version Android ou iOS, le message exact et les étapes qui ont conduit au problème.")}</p><p>{tr(locale, "Masquez les noms réels sur vos captures. N’envoyez aucun mot de passe, reçu complet, clé privée ou jeton de reconnexion.")}</p>{siteConfig.email ? <a class="button primary contact-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> : <p class="notice">{tr(locale, "L’adresse d’assistance sera indiquée avant publication.")}</p>}<p class="muted">{tr(locale, "Ce lien ouvre votre application de messagerie. Aucun formulaire ni envoi automatique n’est intégré au site.")}</p></section>
    </article>
  </div>
</Shell>
